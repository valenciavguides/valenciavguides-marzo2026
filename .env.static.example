# ====================================
# Valencia VGuides - Servidor estático
# ====================================
# Fichero de referencia para el proceso que lanza js/server.js (puerto 8080).
# Copiar a .env o inyectar como variables de entorno al arrancar el proceso.

# ====================================
# PROTECCIÓN DE DATOS (ítem 7)
# ====================================
# false = acceso libre a todos los ficheros JS (desarrollo/test)
# true  = bloquea GET directo a coordenadas, textos, retos, puzzles y audios
#         Los hijos deben obtener esos datos a través del backend autenticado
PROTECT_DATA=false

# ====================================
# INSTRUCCIONES
# ====================================
# DESARROLLO / TEST:
#   node js/server.js
#   (PROTECT_DATA=false por defecto — los E2E necesitan acceso libre)
#
# PRODUCCIÓN:
#   PROTECT_DATA=true node js/server.js
#
# Verificar que la protección está activa:
#   curl -I https://valenciavguides.es/js/coordenadas-aventuras.js
#   Respuesta esperada: HTTP/1.1 403 Forbidden
