{
  "name": "valenciavguides-e2e",
  "private": true,
  "description": "Tests E2E con Playwright — Valencia VGuides",
  "scripts": {
    "postinstall": "node tools/install-hooks.js",
    "build:sw": "node tools/build-sw.js",
    "dev:watch": "node tools/watch-sw.js",
    "inventory": "node tools/inventory.js",
    "inventory:dupes": "node tools/inventory.js --duplicates",
    "inventory:file": "node tools/inventory.js --by-file",
    "verificar-mensajeria": "node tools/verificar-mensajeria.js",
    "verificar-media": "node tools/verificar-media.js",
    "verificar-docs": "node tools/verificar-docs.js",
    "generar-guiones": "node tools/generar-guiones-aventuras.mjs",
    "generar-tramos-video": "node tools/generar-tramos-para-videos.mjs",
    "lint": "eslint \"js/**/*.js\" \"*.html\"",
    "lint:fix": "eslint \"js/**/*.js\" \"*.html\" --fix",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report tests/e2e/report"
  },
  "devDependencies": {
    "@playwright/test": "^1.44.0",
    "eslint": "^10.3.0",
    "eslint-plugin-html": "^8.1.4",
    "eslint-plugin-import-x": "^4.17.1"
  },
  "overrides": {
    "brace-expansion": "^5.0.7"
  }
}
