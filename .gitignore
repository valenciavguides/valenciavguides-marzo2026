# ====================================
# Valencia VGuides — .gitignore
# ====================================

# Variables de entorno (credenciales reales — NUNCA al repositorio)
backend/.env
backend/.env.local
backend/.env.production

# Certificados SSL
backend/certs/

# Logs (pueden contener IPs reales)
backend/logs/

# Dependencias
node_modules/
backend/node_modules/

# Caché y builds
.cache/
dist/

# Artefactos de tests generados automáticamente (no trackear)
test-results/
playwright-report/

# Editor
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# Archivos temporales
temp.txt
temp2.txt

# Configuración local de Claude Code (machine-specific)
.claude/settings.local.json

# Artefactos del bare repo en la raíz del proyecto (git internals — no trackear)
/HEAD
/config
/description
/objects/
/refs/
/info/
/hooks/

# Archivos temporales de backup para historial git
codigo-padre-old.html
codigo-padre-current.html

# Herramientas de análisis local
.sixth/
.trunk/

# Documentos de negocio — solo local, NUNCA a GitHub (infraestructura, pagos, legal/fiscal)
docs/plan-produccion-infraestructura.md

# Imágenes de contenido por idioma — fuera de git DE MOMENTO, por decisión explícita:
# todavía no están referenciadas desde ninguna parte de la PWA, así que subirlas solo
# añadiría peso al repositorio, y este repositorio es PÚBLICO (lo que entra en el
# historial de git sigue siendo accesible aunque después se borre del árbol).
# Para empezar a versionarlas, borrar estas líneas y hacer el `git add` normal.
imagenes/01-imagenes-español/
imagenes/02-imagenes-ingles/
imagenes/03-imagenes-frances/
imagenes/04-imagenes-italiano/
