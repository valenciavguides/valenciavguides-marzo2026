const sharedLangs = ["es", "en", "fr", "it", "nl", "ja", "de", "zh", "pl", "pt", "ru", "uk"];

function findTextEntry(entries, id) {
  return Array.isArray(entries) ? entries.find((entry) => entry.id === id) : undefined;
}

function copyContentIfEmpty(targetEntries, targetId, sourceEntries, sourceId) {
  const targetEntry = findTextEntry(targetEntries, targetId);
  const sourceEntry = findTextEntry(sourceEntries, sourceId);

  if (!targetEntry || !sourceEntry) return;

  const hasContent  = typeof targetEntry.content  === "string" && targetEntry.content.trim()  !== "";
  const hasParrafos = Array.isArray(targetEntry.parrafos) && targetEntry.parrafos.length > 0;
  if (hasContent || hasParrafos) return;

  targetEntry.content = sourceEntry.content;
}

const sharedTextAdventureMap = [
  { key: "Aventura2", p0Prefix: "txt-Av2-P0-", finalPrefix: "txt-Av2-P30-" },
  { key: "Aventura3", p0Prefix: "txt-Av3-P0-", finalPrefix: "txt-Av3-P39-" },
  { key: "Aventura4", p0Prefix: "txt-Av4-P0-", finalPrefix: "txt-Av4-P35-" },
  { key: "Aventura5", p0Prefix: "txt-Av5-P0-", finalPrefix: "txt-Av5-P36-" },
];

for (const language of sharedLangs) {
  const sourceEntries = TEXTOS_AVENTURAS.Aventura1?.[language];
  if (!Array.isArray(sourceEntries)) {
    continue;
  }

  for (const adventureConfig of sharedTextAdventureMap) {
    const targetEntries = TEXTOS_AVENTURAS[adventureConfig.key]?.[language];
    if (!Array.isArray(targetEntries)) {
      continue;
    }

    copyContentIfEmpty(targetEntries, `txt-intro-${language}`, sourceEntries, `txt-intro-${language}`);
    copyContentIfEmpty(targetEntries, `${adventureConfig.p0Prefix}${language}`, sourceEntries, `txt-Av1-P0-${language}`);
    copyContentIfEmpty(targetEntries, `${adventureConfig.finalPrefix}${language}`, sourceEntries, `txt-Av1-P40-${language}`);
  }
}